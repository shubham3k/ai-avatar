generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma (unlike the previous
// PostgreSQL datasource) — these are now plain `String` columns on the
// models below. The allowed values are unchanged; they're validated at the
// application boundary (Zod contracts in packages/shared) instead of by
// the database. Kept here as documentation of the valid values:
//
// IntegrationProvider: "google"
// IntegrationStatus:   "connected" | "needs_reauth" | "error" | "disabled"
// SignalType:          "user_action_required" | "reply_needed" | "approval_needed" | "deadline" | "upcoming_meeting" | "follow_up"
// SignalStatus:        "open" | "resolved" | "ignored"
// InterventionStatus:  "pending" | "snoozed" | "resolved" | "dismissed"
// Priority:            "low" | "medium" | "high" | "critical"

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  displayName   String?
  timezone      String          @default("UTC")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  integrations  Integration[]
  emails        Email[]
  calendarEvents CalendarEvent[]
  signals       Signal[]
  interventions Intervention[]
  agentRuns     AgentRun[]
  goals         Goal[]
  reminders     Reminder[]
}

model Integration {
  id                    String    @id @default(cuid())
  userId                String
  provider              String
  status                String    @default("connected")
  providerAccountId     String?
  providerAccountEmail  String?
  refreshTokenEncrypted String
  accessTokenEncrypted  String?
  expiresAt             DateTime?
  scopes                String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId, status])
  @@index([provider, providerAccountId])
}

model Email {
  id                String   @id @default(cuid())
  userId            String
  providerMessageId String
  threadId          String
  fromEmail         String
  fromName          String?
  toEmails          String
  subject           String
  snippet           String?
  bodyText          String?
  receivedAt        DateTime
  isRead            Boolean  @default(false)
  labels            String   @default("[]")
  sourceUrl         String?
  rawUpdatedAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerMessageId])
  @@index([userId, receivedAt])
  @@index([userId, threadId])
}

model CalendarEvent {
  id               String    @id @default(cuid())
  userId           String
  providerEventId  String
  calendarId       String
  title            String
  description      String?
  location         String?
  startAt          DateTime
  endAt            DateTime
  isAllDay         Boolean   @default(false)
  status           String?
  organizerEmail   String?
  organizerName    String?
  attendeeEmails   String
  attendees        String?
  sourceUrl        String?
  rawUpdatedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, calendarId, providerEventId])
  @@index([userId, startAt])
}

model Signal {
  id               String      @id @default(cuid())
  userId           String
  type             String
  sourceType       String
  sourceId         String
  title            String
  summary          String
  dueAt            DateTime?
  importanceHints  String?
  status           String      @default("open")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  interventions    Intervention[]

  @@unique([userId, type, sourceType, sourceId])
  @@index([userId, status, dueAt])
}

model Intervention {
  id              String     @id @default(cuid())
  userId          String
  signalId        String
  status          String     @default("pending")
  priority        String
  title           String
  message         String
  reason          String
  actionType      String
  actionPayload   String?
  snoozedUntil    DateTime?
  createdAt       DateTime   @default(now())
  resolvedAt      DateTime?
  lastDeliveredAt DateTime?
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal          Signal     @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([signalId])
  @@index([userId, status, priority])
  @@index([userId, snoozedUntil])
}

// Phase 3.4 — basic, user-owned goals/commitments. Deliberately minimal:
// no hierarchy, no progress tracking, no task/project management.
model Goal {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

// User-created reminders ("remind me to X at Y"). reminder-detection.service.ts
// turns a due reminder into a Signal/Intervention through the same pipeline
// Gmail/Calendar signals use; the Reminder row itself is never marked
// resolved — only the Intervention it spawns is, exactly like
// Email/CalendarEvent rows already work.
//
// dueAt is the real deadline/event time the user cares about (e.g. "send
// the invoice at 5pm" -> dueAt is 5pm, so the intervention's message can
// still say "at 5pm" even though it was surfaced earlier). remindAt is when
// the popup should actually appear — null for a reminder created with an
// exact date/time picker (fires exactly at dueAt, the original behavior);
// set to some time before dueAt for one parsed from free text via Groq
// (reminders.service.ts's createReminderFromText), mirroring how a
// calendar meeting reminder fires ahead of the meeting itself, not at it.
model Reminder {
  id        String    @id @default(cuid())
  userId    String
  text      String
  dueAt     DateTime
  remindAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
}

model AgentRun {
  id           String   @id @default(cuid())
  userId       String
  triggerType  String
  inputSummary String
  model        String
  outputJson   String?
  status       String
  errorCode    String?
  durationMs   Int?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ADR-006: one row per successful AI provider call, for "usage this month"
// in Settings. Counts only — never prompt/response content. App-level (not
// per-user): the desktop app is single-user and usage is billed per API key.
model LlmUsage {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  provider          String // "openai" | "groq"
  model             String
  operation         String // "reminder_parse" | "prioritization" | "transcription" | "other"
  inputTokens       Int      @default(0)
  cachedInputTokens Int      @default(0)
  outputTokens      Int      @default(0)
  audioSeconds      Float    @default(0)
  // Estimated at record time from pricing.ts; null when the model's price is unknown.
  costUsd           Float?

  @@index([createdAt])
}

// ADR-006 (M2): chats with Zara. Stored locally forever (deletion options
// arrive with M3). Only what the user and Zara said is stored — tool calls
// and their results are transient, re-derived from local data each turn.
model Conversation {
  id        String        @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant"
  content        String
  // Which provider produced an assistant reply ("openai" | "groq"); null for user messages.
  provider       String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ADR-006 (M3): lasting facts Zara learned about the user ("Rahul is my
// manager"). Local only; editable/deletable from Settings or by telling
// Zara. Sensitive details (passwords, card/ID numbers…) are never stored.
model MemoryFact {
  id        String   @id @default(cuid())
  userId    String
  content   String
  category  String // "about_you" | "people" | "preferences" | "other"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

// ADR-006 (M3): everything Zara did, newest first in Settings. `undo` holds
// what's needed to reverse the action (JSON), null when it can't be undone.
model ActivityEntry {
  id        String    @id @default(cuid())
  userId    String
  createdAt DateTime  @default(now())
  kind      String // "reminder_created" | "reminder_deleted" | "memory_saved" | "memory_updated" | "memory_deleted"
  summary   String
  // Which provider was answering when Zara took the action ("openai" | "groq").
  provider  String?
  undo      String?
  undoneAt  DateTime?

  @@index([userId, createdAt])
}
